<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
  <title>Admin Dashboard — WA Checker</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --g1:#25D366; --g2:#128C7E; --g3:#075E54;
      --bg:#050a07; --s1:#0d1710; --s2:#0f1f13; --s3:#091309;
      --border:rgba(37,211,102,.14); --border2:rgba(37,211,102,.07);
      --text:#e8f5e9; --muted:#6fa87e; --dim:#3d6b4a;
      --red:#f05555; --yellow:#f0c040; --blue:#4fa8f0;
      --sb:240px;
    }

    html,body { height:100%; -webkit-font-smoothing:antialiased; }
    body {
      font-family:'Inter','Segoe UI',sans-serif;
      background:var(--bg); color:var(--text);
      min-height:100vh; overflow-x:hidden;
    }

    /* ══════════ SIDEBAR ══════════ */
    .sidebar {
      width: var(--sb); background:var(--s3);
      border-right:1px solid var(--border2);
      display:flex; flex-direction:column;
      position:fixed; top:0; left:0; bottom:0; z-index:200;
      transition: transform .28s cubic-bezier(.4,0,.2,1);
    }
    /* mobile: hidden off-screen by default */
    @media(max-width:768px) {
      .sidebar { transform:translateX(-100%); box-shadow:4px 0 32px rgba(0,0,0,.5); }
      .sidebar.open { transform:translateX(0); }
    }

    .sb-brand {
      padding:22px 18px 18px; border-bottom:1px solid var(--border2);
      display:flex; align-items:center; gap:10px; flex-shrink:0;
    }
    .sb-logo {
      width:38px; height:38px; flex-shrink:0;
      background:linear-gradient(135deg,var(--g2),var(--g1));
      border-radius:11px; display:flex; align-items:center; justify-content:center;
      font-size:18px; box-shadow:0 0 16px rgba(37,211,102,.25);
    }
    .sb-title { font-size:.88rem; font-weight:700; }
    .sb-sub   { font-size:.65rem; color:var(--muted); }

    .sb-nav { flex:1; padding:16px 10px; display:flex; flex-direction:column; gap:3px; overflow-y:auto; }
    .sb-section-label {
      font-size:.62rem; font-weight:700; color:var(--dim);
      text-transform:uppercase; letter-spacing:.8px;
      padding:0 10px; margin:12px 0 4px;
    }
    .sb-item {
      display:flex; align-items:center; gap:10px;
      padding:9px 10px; border-radius:10px;
      font-size:.83rem; font-weight:500; color:var(--muted);
      text-decoration:none; border:1px solid transparent;
      transition:all .18s; -webkit-tap-highlight-color:transparent;
    }
    .sb-item:hover,.sb-item.active {
      background:rgba(37,211,102,.08); color:var(--text); border-color:rgba(37,211,102,.15);
    }
    .sb-item.active { color:var(--g1); }
    .sb-icon { font-size:.95rem; width:20px; text-align:center; flex-shrink:0; }

    .sb-footer { padding:14px 10px; border-top:1px solid var(--border2); flex-shrink:0; }
    .sb-back {
      display:flex; align-items:center; gap:10px;
      padding:9px 10px; border-radius:10px;
      font-size:.83rem; font-weight:500; color:var(--muted);
      text-decoration:none; border:1px solid transparent;
      transition:all .18s; -webkit-tap-highlight-color:transparent;
    }
    .sb-back:hover { background:rgba(37,211,102,.06); color:var(--text); border-color:var(--border2); }

    /* overlay behind sidebar on mobile */
    .overlay {
      display:none; position:fixed; inset:0; background:rgba(0,0,0,.6);
      z-index:190; backdrop-filter:blur(2px); -webkit-backdrop-filter:blur(2px);
    }
    .overlay.open { display:block; }

    /* ══════════ MAIN ══════════ */
    .main {
      margin-left:var(--sb);
      display:flex; flex-direction:column; min-height:100vh;
    }
    @media(max-width:768px) { .main { margin-left:0; } }

    /* ══════════ TOPBAR ══════════ */
    .topbar {
      height:60px; padding:0 clamp(16px,3vw,32px);
      border-bottom:1px solid var(--border2);
      display:flex; align-items:center; justify-content:space-between; gap:12px;
      background:rgba(5,10,7,.8); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);
      position:sticky; top:0; z-index:100; flex-shrink:0;
    }
    .topbar-left { display:flex; align-items:center; gap:12px; min-width:0; }
    .menu-btn {
      display:none; width:36px; height:36px; flex-shrink:0;
      background:rgba(37,211,102,.08); border:1px solid var(--border);
      border-radius:9px; align-items:center; justify-content:center;
      font-size:1rem; cursor:pointer; transition:all .18s;
      -webkit-tap-highlight-color:transparent;
    }
    .menu-btn:hover { background:rgba(37,211,102,.15); }
    @media(max-width:768px) { .menu-btn { display:flex; } }

    .topbar-title { font-size:.95rem; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .topbar-crumb { font-size:.7rem; color:var(--muted); }
    .live-badge {
      display:flex; align-items:center; gap:6px; flex-shrink:0;
      background:rgba(37,211,102,.08); border:1px solid rgba(37,211,102,.2);
      border-radius:100px; padding:5px 12px;
      font-size:.72rem; font-weight:600; color:var(--g1); white-space:nowrap;
    }
    .dot { width:7px; height:7px; background:var(--g1); border-radius:50%; flex-shrink:0; animation:blink 1.6s ease-in-out infinite; }
    @keyframes blink{0%,100%{opacity:1}50%{opacity:.1}}

    /* ══════════ CONTENT ══════════ */
    .content { padding:clamp(16px,3vw,32px); flex:1; }

    /* ══════════ STATS ══════════ */
    .stats-grid {
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
      gap:12px; margin-bottom:24px;
    }
    .stat {
      background:var(--s1); border:1px solid var(--border2);
      border-radius:15px; padding:18px 18px;
      transition:border-color .2s,transform .2s;
    }
    .stat:hover { border-color:var(--border); transform:translateY(-2px); }
    .stat-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
    .stat-icon {
      width:36px; height:36px; border-radius:9px;
      display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0;
    }
    .ic-green  { background:rgba(37,211,102,.12); }
    .ic-yellow { background:rgba(240,192,64,.12); }
    .ic-red    { background:rgba(240,85,85,.12); }
    .ic-blue   { background:rgba(79,168,240,.12); }
    .stat-trend { font-size:.68rem; color:var(--muted); }
    .stat-val { font-size:clamp(1.5rem,4vw,2rem); font-weight:800; letter-spacing:-1px; }
    .stat-lbl { font-size:.72rem; color:var(--muted); margin-top:2px; }

    /* ══════════ CARD ══════════ */
    .card { background:var(--s1); border:1px solid var(--border2); border-radius:16px; overflow:hidden; margin-bottom:20px; }
    .card-head {
      padding:16px clamp(16px,3vw,24px); border-bottom:1px solid var(--border2);
      display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;
    }
    .card-title { font-size:.88rem; font-weight:700; display:flex; align-items:center; gap:7px; }
    .card-badge {
      font-size:.7rem; border-radius:100px; padding:3px 10px; font-weight:600; white-space:nowrap;
    }
    .badge-ok  { background:rgba(37,211,102,.1); color:var(--g1); border:1px solid rgba(37,211,102,.2); }
    .badge-warn{ background:rgba(240,85,85,.1);  color:var(--red);border:1px solid rgba(240,85,85,.2); }
    .badge-num { background:rgba(37,211,102,.08);color:var(--muted);border:1px solid var(--border2); }

    /* ══════════ CONFIG FORM ══════════ */
    .config-body { padding:clamp(16px,3vw,24px); }
    .config-grid {
      display:grid; grid-template-columns:1fr 1fr; gap:14px;
    }
    @media(max-width:560px) { .config-grid { grid-template-columns:1fr; } }
    .form-group { display:flex; flex-direction:column; gap:6px; }
    .form-label { font-size:.7rem; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; }
    .form-input {
      padding:11px 13px; background:var(--s2); border:1px solid var(--border);
      border-radius:10px; color:var(--text); font-size:.88rem;
      outline:none; font-family:inherit; transition:border-color .2s,box-shadow .2s;
      -webkit-appearance:none; appearance:none;
    }
    .form-input::placeholder { color:rgba(111,168,126,.28); }
    .form-input:focus { border-color:var(--g2); box-shadow:0 0 0 3px rgba(37,211,102,.1); }
    .config-footer {
      padding:14px clamp(16px,3vw,24px); border-top:1px solid var(--border2);
      display:flex; justify-content:flex-end;
    }
    .btn-save {
      padding:10px 24px;
      background:linear-gradient(135deg,var(--g3),var(--g2));
      border:none; border-radius:10px; color:#fff;
      font-size:.86rem; font-weight:700; cursor:pointer; font-family:inherit;
      transition:all .2s; box-shadow:0 4px 14px rgba(37,211,102,.22);
      -webkit-tap-highlight-color:transparent;
    }
    .btn-save:hover { transform:translateY(-2px); box-shadow:0 6px 22px rgba(37,211,102,.35); }
    .btn-save:active { transform:scale(.98); }

    /* ══════════ TABLE ══════════ */
    .table-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; }
    table { width:100%; border-collapse:collapse; min-width:500px; }
    thead { background:var(--s2); }
    th {
      padding:11px 16px; font-size:.67rem; font-weight:700;
      color:var(--dim); text-transform:uppercase; letter-spacing:.6px; text-align:left;
      white-space:nowrap;
    }
    td { padding:13px 16px; font-size:.84rem; border-top:1px solid var(--border2); vertical-align:middle; }
    tbody tr { transition:background .15s; }
    tbody tr:hover td { background:rgba(37,211,102,.025); }

    .rank { font-size:.78rem; font-weight:800; color:var(--dim); }
    .rank-1{color:#f0c040} .rank-2{color:#b0c0cc} .rank-3{color:#cd7f32}

    .user-cell { display:flex; align-items:center; gap:10px; }
    .avatar {
      width:34px; height:34px; flex-shrink:0; border-radius:50%;
      background:linear-gradient(135deg,var(--g3),var(--g2));
      display:flex; align-items:center; justify-content:center;
      font-size:.8rem; font-weight:800; border:1px solid rgba(37,211,102,.2);
    }
    .user-name { font-weight:600; font-size:.85rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:140px; }
    .user-id   { font-size:.68rem; color:var(--dim); white-space:nowrap; }

    .pill {
      display:inline-flex; align-items:center; gap:4px;
      border-radius:100px; padding:3px 10px;
      font-size:.7rem; font-weight:700; white-space:nowrap;
    }
    .pill-green  { background:rgba(37,211,102,.1); color:var(--g1); border:1px solid rgba(37,211,102,.2); }
    .pill-red    { background:rgba(240,85,85,.1);  color:var(--red);  border:1px solid rgba(240,85,85,.2); }
    .pill-yellow { background:rgba(240,192,64,.1); color:var(--yellow);border:1px solid rgba(240,192,64,.2); }

    .actions { display:flex; gap:5px; flex-wrap:wrap; }
    .act {
      padding:4px 10px; border-radius:7px; font-size:.72rem; font-weight:600;
      text-decoration:none; border:1px solid transparent; transition:all .16s;
      white-space:nowrap; -webkit-tap-highlight-color:transparent;
    }
    .act-approve { background:rgba(37,211,102,.08); color:var(--g1); border-color:rgba(37,211,102,.2); }
    .act-approve:hover { background:rgba(37,211,102,.18); }
    .act-ban     { background:rgba(240,85,85,.08); color:var(--red); border-color:rgba(240,85,85,.2); }
    .act-ban:hover { background:rgba(240,85,85,.18); }
    .act-unban   { background:rgba(240,192,64,.08); color:var(--yellow); border-color:rgba(240,192,64,.2); }
    .act-unban:hover { background:rgba(240,192,64,.18); }

    .checks { font-weight:700; color:var(--g1); }
    .empty  { padding:40px; text-align:center; color:var(--dim); font-size:.85rem; }

    /* ══════════ TOUCH OPTIMISATIONS ══════════ */
    @media(hover:none) {
      .stat:hover { transform:none; }
      .btn-save:hover { transform:none; box-shadow:0 4px 14px rgba(37,211,102,.22); }
    }
  </style>
</head>
<body>

  <!-- mobile overlay -->
  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <!-- ── SIDEBAR ── -->
  <aside class="sidebar" id="sidebar">
    <div class="sb-brand">
      <div class="sb-logo">🛡️</div>
      <div>
        <div class="sb-title">Admin Panel</div>
        <div class="sb-sub">WA Number Checker</div>
      </div>
    </div>
    <nav class="sb-nav">
      <div class="sb-section-label">Overview</div>
      <a class="sb-item active" href="#stats" onclick="closeSidebar()">
        <span class="sb-icon">📊</span> Dashboard
      </a>
      <div class="sb-section-label">Management</div>
      <a class="sb-item" href="#config" onclick="closeSidebar()">
        <span class="sb-icon">⚙️</span> API Config
      </a>
      <a class="sb-item" href="#top-users" onclick="closeSidebar()">
        <span class="sb-icon">🏆</span> Top Users
      </a>
      <a class="sb-item" href="#all-users" onclick="closeSidebar()">
        <span class="sb-icon">👥</span> All Users
      </a>
    </nav>
    <div class="sb-footer">
      <a href="/" class="sb-back"><span class="sb-icon">←</span> Back to Site</a>
    </div>
  </aside>

  <!-- ── MAIN ── -->
  <div class="main">

    <!-- TOPBAR -->
    <div class="topbar">
      <div class="topbar-left">
        <button class="menu-btn" onclick="toggleSidebar()" aria-label="Menu">☰</button>
        <div>
          <div class="topbar-title">Dashboard</div>
          <div class="topbar-crumb">Admin / Overview</div>
        </div>
      </div>
      <div class="live-badge"><span class="dot"></span> Live</div>
    </div>

    <div class="content">

      <!-- STATS -->
      <div class="stats-grid" id="stats">
        <div class="stat">
          <div class="stat-top"><div class="stat-icon ic-blue">👥</div><span class="stat-trend">Total</span></div>
          <div class="stat-val"><%= users.length %></div>
          <div class="stat-lbl">Registered Users</div>
        </div>
        <div class="stat">
          <div class="stat-top"><div class="stat-icon ic-green">✅</div><span class="stat-trend">Active</span></div>
          <div class="stat-val"><%= users.filter(u=>u.approved&&!u.banned).length %></div>
          <div class="stat-lbl">Approved Users</div>
        </div>
        <div class="stat">
          <div class="stat-top"><div class="stat-icon ic-yellow">⏳</div><span class="stat-trend">Waiting</span></div>
          <div class="stat-val"><%= users.filter(u=>!u.approved&&!u.banned).length %></div>
          <div class="stat-lbl">Pending Approval</div>
        </div>
        <div class="stat">
          <div class="stat-top"><div class="stat-icon ic-red">🚫</div><span class="stat-trend">Blocked</span></div>
          <div class="stat-val"><%= users.filter(u=>u.banned).length %></div>
          <div class="stat-lbl">Banned Users</div>
        </div>
        <div class="stat">
          <div class="stat-top"><div class="stat-icon ic-green">🔢</div><span class="stat-trend">All time</span></div>
          <div class="stat-val"><%= users.reduce((s,u)=>s+u.totalChecked,0).toLocaleString() %></div>
          <div class="stat-lbl">Numbers Checked</div>
        </div>
      </div>

      <!-- API CONFIG -->
      <div class="card" id="config">
        <div class="card-head">
          <div class="card-title">⚙️ API Configuration</div>
          <% if(config?.apiUrl){ %>
          <span class="card-badge badge-ok">✅ Configured</span>
          <% } else { %>
          <span class="card-badge badge-warn">⚠️ Not Set</span>
          <% } %>
        </div>
        <form method="POST" action="/admin/config">
          <div class="config-body">
            <div class="config-grid">
              <div class="form-group">
                <label class="form-label">API URL</label>
                <input class="form-input" name="apiUrl" value="<%= config?.apiUrl ?? '' %>" placeholder="https://api.maytapi.com/..." required/>
              </div>
              <div class="form-group">
                <label class="form-label">API Token</label>
                <input class="form-input" name="apiToken" type="password" value="<%= config?.apiToken ?? '' %>" placeholder="••••••••••••"/>
              </div>
            </div>
          </div>
          <div class="config-footer">
            <button class="btn-save" type="submit">💾 Save Configuration</button>
          </div>
        </form>
      </div>

      <!-- TOP USERS -->
      <div class="card" id="top-users">
        <div class="card-head">
          <div class="card-title">🏆 Top Users</div>
          <span class="card-badge badge-num"><%= topUsers.length %> users</span>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>Rank</th><th>User</th><th>Checks</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
            <% topUsers.forEach((u,i)=>{ %>
              <tr>
                <td><span class="rank rank-<%=i+1%>">#<%=i+1%></span></td>
                <td>
                  <div class="user-cell">
                    <div class="avatar"><%=(u.name||'?')[0].toUpperCase()%></div>
                    <div>
                      <div class="user-name"><%=u.name||'Unknown'%></div>
                      <div class="user-id"><%=u.userId%></div>
                    </div>
                  </div>
                </td>
                <td><span class="checks"><%=u.totalChecked.toLocaleString()%></span></td>
                <td>
                  <%if(u.banned){%><span class="pill pill-red">🚫 Banned</span>
                  <%}else if(u.approved){%><span class="pill pill-green">✅ Approved</span>
                  <%}else{%><span class="pill pill-yellow">⏳ Pending</span><%}%>
                </td>
                <td>
                  <div class="actions">
                    <%if(!u.approved&&!u.banned){%><a href="/admin/approve/<%=u.userId%>" class="act act-approve">✅ Approve</a><%}%>
                    <%if(!u.banned){%><a href="/admin/ban/<%=u.userId%>" class="act act-ban">🚫 Ban</a>
                    <%}else{%><a href="/admin/unban/<%=u.userId%>" class="act act-unban">🔓 Unban</a><%}%>
                  </div>
                </td>
              </tr>
            <%})%>
            <%if(!topUsers.length){%><tr><td colspan="5"><div class="empty">No users yet</div></td></tr><%}%>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ALL USERS -->
      <div class="card" id="all-users">
        <div class="card-head">
          <div class="card-title">👥 All Users</div>
          <span class="card-badge badge-num"><%=users.length%> total</span>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>User</th><th>Checks</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
            <%users.forEach(u=>{%>
              <tr>
                <td>
                  <div class="user-cell">
                    <div class="avatar"><%=(u.name||'?')[0].toUpperCase()%></div>
                    <div>
                      <div class="user-name"><%=u.name||'Unknown'%></div>
                      <div class="user-id"><%=u.userId%></div>
                    </div>
                  </div>
                </td>
                <td><span class="checks"><%=u.totalChecked.toLocaleString()%></span></td>
                <td>
                  <%if(u.banned){%><span class="pill pill-red">🚫 Banned</span>
                  <%}else if(u.approved){%><span class="pill pill-green">✅ Approved</span>
                  <%}else{%><span class="pill pill-yellow">⏳ Pending</span><%}%>
                </td>
                <td>
                  <div class="actions">
                    <%if(!u.approved&&!u.banned){%><a href="/admin/approve/<%=u.userId%>" class="act act-approve">✅ Approve</a><%}%>
                    <%if(!u.banned){%><a href="/admin/ban/<%=u.userId%>" class="act act-ban">🚫 Ban</a>
                    <%}else{%><a href="/admin/unban/<%=u.userId%>" class="act act-unban">🔓 Unban</a><%}%>
                  </div>
                </td>
              </tr>
            <%})%>
            <%if(!users.length){%><tr><td colspan="4"><div class="empty">No users yet</div></td></tr><%}%>
            </tbody>
          </table>
        </div>
      </div>

    </div><!-- /content -->
  </div><!-- /main -->

  <script>
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('open');
      document.getElementById('overlay').classList.toggle('open');
    }
    function closeSidebar() {
      document.getElementById('sidebar').classList.remove('open');
      document.getElementById('overlay').classList.remove('open');
    }
    // close sidebar on escape
    document.addEventListener('keydown', e => { if(e.key==='Escape') closeSidebar(); });
    // smooth scroll anchor offset
    document.querySelectorAll('a[href^="#"]').forEach(a => {
      a.addEventListener('click', e => {
        const id = a.getAttribute('href').slice(1);
        const el = document.getElementById(id);
        if (el) {
          e.preventDefault();
          const top = el.getBoundingClientRect().top + window.scrollY - 72;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });
  </script>

</body>
</html>
