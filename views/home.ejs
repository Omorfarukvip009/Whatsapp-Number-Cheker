<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
  <title>WA Number Checker — Bot Status</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --g1: #25D366; --g2: #128C7E; --g3: #075E54;
      --bg: #050a07; --s1: #0d1710; --s2: #0f1f13;
      --border: rgba(37,211,102,.15); --border2: rgba(37,211,102,.08);
      --text: #e8f5e9; --muted: #6fa87e; --dim: #3d6b4a;
    }

    html { scroll-behavior: smooth; }
    html, body { height: 100%; }
    body {
      font-family: 'Inter', 'Segoe UI', sans-serif;
      background: var(--bg); color: var(--text);
      min-height: 100vh; overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ── BACKGROUND ── */
    .bg-layer {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background:
        radial-gradient(ellipse 80% 60% at 20% 10%, rgba(37,211,102,.09) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 85% 80%, rgba(18,140,126,.08) 0%, transparent 55%),
        radial-gradient(ellipse 40% 40% at 50% 50%, rgba(37,211,102,.03) 0%, transparent 70%);
    }
    .grid-overlay {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background-image:
        linear-gradient(rgba(37,211,102,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(37,211,102,.04) 1px, transparent 1px);
      background-size: 60px 60px;
      mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
    }

    /* ── LAYOUT ── */
    .page { position: relative; z-index: 1; min-height: 100vh; display: flex; flex-direction: column; }

    /* ── NAV ── */
    nav {
      padding: 16px clamp(16px, 5vw, 40px);
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid var(--border2);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      position: sticky; top: 0; z-index: 100;
      background: rgba(5,10,7,.6);
    }
    .nav-brand { display: flex; align-items: center; gap: 10px; }
    .nav-logo {
      width: 36px; height: 36px; flex-shrink: 0;
      background: linear-gradient(135deg, var(--g2), var(--g1));
      border-radius: 10px; display: flex; align-items: center; justify-content: center;
      font-size: 18px; box-shadow: 0 0 20px rgba(37,211,102,.3);
    }
    .nav-name { font-size: .95rem; font-weight: 700; letter-spacing: -.3px; }
    .nav-tag  { font-size: .68rem; color: var(--muted); }

    .status-pill {
      display: flex; align-items: center; gap: 7px;
      background: rgba(37,211,102,.08); border: 1px solid rgba(37,211,102,.2);
      border-radius: 100px; padding: 6px 14px;
      font-size: .75rem; font-weight: 600; color: var(--g1);
      white-space: nowrap;
    }
    .dot { width: 7px; height: 7px; background: var(--g1); border-radius: 50%; flex-shrink:0; animation: blink 1.6s ease-in-out infinite; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.15} }

    /* ── HERO ── */
    .hero {
      flex: 1; display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: clamp(48px, 8vw, 80px) clamp(16px, 5vw, 24px) clamp(40px, 6vw, 60px);
      text-align: center;
    }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(37,211,102,.07); border: 1px solid rgba(37,211,102,.2);
      border-radius: 100px; padding: 6px 16px; margin-bottom: clamp(24px, 4vw, 36px);
      font-size: .73rem; font-weight: 600; color: var(--muted); letter-spacing: .5px;
      text-transform: uppercase;
    }

    .hero-icon-ring {
      position: relative; display: inline-flex;
      align-items: center; justify-content: center;
      margin-bottom: clamp(28px, 5vw, 40px);
      width: 200px; height: 200px;
    }
    .ring {
      position: absolute; border-radius: 50%; border: 1px solid rgba(37,211,102,.2);
      animation: expand 3s ease-out infinite;
    }
    .ring:nth-child(1) { width: 110px; height: 110px; animation-delay: 0s; }
    .ring:nth-child(2) { width: 150px; height: 150px; animation-delay: .8s; }
    .ring:nth-child(3) { width: 190px; height: 190px; animation-delay: 1.6s; }
    @keyframes expand {
      0%   { transform: scale(.8); opacity: .6; }
      100% { transform: scale(1.2); opacity: 0; }
    }
    .hero-icon {
      width: 80px; height: 80px; position: relative; z-index: 2;
      background: linear-gradient(145deg, var(--g3), var(--g2), var(--g1));
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-size: 36px; box-shadow: 0 0 40px rgba(37,211,102,.4), 0 0 80px rgba(37,211,102,.15);
    }

    h1 {
      font-size: clamp(2rem, 7vw, 3.8rem);
      font-weight: 900; letter-spacing: clamp(-1px, -.5vw, -2px); line-height: 1.05;
      margin-bottom: 16px;
    }
    .h1-white { color: var(--text); }
    .h1-green {
      background: linear-gradient(135deg, var(--g1) 0%, #7fffa8 60%, var(--g1) 100%);
      background-size: 200%;
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      animation: shimmer 4s linear infinite;
    }
    @keyframes shimmer { 0%{background-position:0%} 100%{background-position:200%} }

    .hero-desc {
      max-width: 520px; font-size: clamp(.9rem, 2.5vw, 1.05rem); color: var(--muted);
      line-height: 1.7; margin-bottom: clamp(36px, 6vw, 52px); font-weight: 400;
      padding: 0 8px;
    }

    /* ── CTA ── */
    .cta-group {
      display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
      margin-bottom: clamp(48px, 8vw, 72px);
      width: 100%; max-width: 440px;
    }

    .btn-primary {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      padding: 14px clamp(20px, 4vw, 32px);
      background: linear-gradient(135deg, var(--g2), var(--g1));
      border: none; border-radius: 14px; color: #fff;
      font-size: clamp(.9rem, 2.5vw, 1rem); font-weight: 700; text-decoration: none;
      cursor: pointer; letter-spacing: -.2px;
      box-shadow: 0 4px 24px rgba(37,211,102,.35), 0 0 0 1px rgba(37,211,102,.3);
      transition: all .25s; position: relative; overflow: hidden;
      flex: 1; min-width: 140px;
      -webkit-tap-highlight-color: transparent;
    }
    .btn-primary::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,.15), transparent);
      opacity: 0; transition: opacity .25s;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 36px rgba(37,211,102,.5); }
    .btn-primary:hover::after { opacity: 1; }
    .btn-primary:active { transform: scale(.97); }

    .btn-secondary {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      padding: 14px clamp(16px, 3vw, 28px);
      background: transparent; border: 1px solid var(--border);
      border-radius: 14px; color: var(--muted);
      font-size: clamp(.9rem, 2.5vw, 1rem); font-weight: 600; text-decoration: none;
      transition: all .25s; flex: 1; min-width: 120px;
      -webkit-tap-highlight-color: transparent;
    }
    .btn-secondary:hover { border-color: rgba(37,211,102,.35); color: var(--text); background: rgba(37,211,102,.05); }
    .btn-secondary:active { transform: scale(.97); }

    /* ── FEATURE CARDS ── */
    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px; max-width: 860px; width: 100%;
    }
    .feat {
      background: var(--s1); border: 1px solid var(--border2);
      border-radius: 18px; padding: clamp(16px, 3vw, 24px);
      text-align: left; transition: border-color .25s, transform .25s;
    }
    .feat:hover { border-color: rgba(37,211,102,.25); transform: translateY(-3px); }
    .feat-icon  { font-size: 1.5rem; margin-bottom: 10px; }
    .feat-title { font-size: clamp(.82rem, 2vw, .9rem); font-weight: 700; margin-bottom: 6px; color: var(--text); }
    .feat-desc  { font-size: clamp(.72rem, 1.8vw, .78rem); color: var(--muted); line-height: 1.6; }

    /* ── FOOTER ── */
    footer {
      padding: 20px clamp(16px, 5vw, 40px); border-top: 1px solid var(--border2);
      display: flex; align-items: center; justify-content: center;
      font-size: .73rem; color: var(--dim); text-align: center;
    }

    /* ── RESPONSIVE ── */
    @media (max-width: 640px) {
      .hero-icon-ring { width: 160px; height: 160px; }
      .ring:nth-child(1) { width: 88px; height: 88px; }
      .ring:nth-child(2) { width: 120px; height: 120px; }
      .ring:nth-child(3) { width: 152px; height: 152px; }
      .hero-icon { width: 66px; height: 66px; font-size: 30px; }
      .cta-group { flex-direction: column; align-items: stretch; }
      .btn-primary, .btn-secondary { text-align: center; }
      .features { grid-template-columns: 1fr; }
    }

    @media (min-width: 641px) and (max-width: 900px) {
      .features { grid-template-columns: 1fr 1fr; }
    }

    /* touch devices — remove hover effects that feel odd */
    @media (hover: none) {
      .feat:hover { transform: none; }
      .btn-primary:hover { transform: none; box-shadow: 0 4px 24px rgba(37,211,102,.35); }
    }
  </style>
</head>
<body>
  <div class="bg-layer"></div>
  <div class="grid-overlay"></div>
  <div class="page">

    <nav>
      <div class="nav-brand">
        <div class="nav-logo">📱</div>
        <div>
          <div class="nav-name">WA Checker</div>
          <div class="nav-tag">Telegram Bot</div>
        </div>
      </div>
      <div class="status-pill"><span class="dot"></span> Bot Online</div>
    </nav>

    <div class="hero">
      <div class="hero-badge">⚡ Make by Md Omor Faruk</div>

      <div class="hero-icon-ring">
        <div class="ring"></div>
        <div class="ring"></div>
        <div class="ring"></div>
        <div class="hero-icon">📲</div>
      </div>

      <h1>
        <span class="h1-white">Check Numbers</span><br>
        <span class="h1-green">Instantly</span>
      </h1>

      <p class="hero-desc">
        A powerful Telegram bot that verifies WhatsApp registration status for bulk phone numbers — fast, secure, and admin-controlled.
      </p>

      <div class="cta-group">
        <a href="/admin/login" class="btn-primary">🛡️ Admin Panel →</a>
        <a href="#features" class="btn-secondary">Learn More ↓</a>
      </div>

      <div class="features" id="features">
        <div class="feat">
          <div class="feat-icon">⚡</div>
          <div class="feat-title">Bulk Checking</div>
          <div class="feat-desc">Verify up to 100 numbers in one message. Results in seconds.</div>
        </div>
        <div class="feat">
          <div class="feat-icon">🔒</div>
          <div class="feat-title">Access Control</div>
          <div class="feat-desc">Approve, ban, or manage every user from the admin dashboard.</div>
        </div>
        <div class="feat">
          <div class="feat-icon">📊</div>
          <div class="feat-title">Usage Tracking</div>
          <div class="feat-desc">Monitor numbers checked per user with live leaderboards.</div>
        </div>
      </div>
    </div>

    <footer>&copy; 2025 WA Number Checker &nbsp;·&nbsp; All rights reserved</footer>
  </div>
</body>
</html>
